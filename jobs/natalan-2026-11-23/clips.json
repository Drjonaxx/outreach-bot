      },
      {
        "start": 18019.68,
        "end": 18021.5,
        "text": "¡Ya no me voy a acordar, culero, hijo de tu"
      },
      {
        "start": 18021.5,
        "end": 18021.96,
        "text": "puta madre!"
      },
      {
        "start": 18117.5,
        "end": 18120.04,
        "text": "«Aquí es donde sostengo tu mano y te digo lo"
      },
      {
        "start": 18120.04,
        "end": 18123.08,
        "text": "siguiente: tienes que llegar hasta la ronda 19, 20»."
      },
      {
        "start": 18123.08,
        "end": 18124.72,
        "text": "¡No, hombre! ¡A"
      },
      {
        "start": 18129.2,
        "end": 18132.36,
        "text": "la verga! No me digas eso. ¿Cómo"
      },
      {
        "start": 18132.36,
        "end": 18135.3,
        "text": "que ronda 20? Llegué a la 11, ya no podía"
      },
      {
        "start": 18135.3,
        "end": 18136.0,
        "text": "más."
      }
    ]
  }
]