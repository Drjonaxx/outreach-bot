# Anthropic API
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn API
# 1. Crea una app en: https://www.linkedin.com/developers/apps
# 2. Activa el producto "Share on LinkedIn"
# 3. Genera un access token con scope: w_member_social
# 4. Obtén tu person ID con: GET https://api.linkedin.com/v2/userinfo
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_ID=your_linkedin_person_id_here

# Threads / Meta API
# 1. Crea una app en: https://developers.facebook.com/apps
# 2. Añade el producto "Threads API"
# 3. Genera un long-lived access token
# 4. Tu user ID es el ID de tu cuenta de Threads
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here
