# ── Anthropic ───────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Threads API ──────────────────────────────────────────────────────────────
# HOW TO GET THESE CREDENTIALS (step by step):
#
# 1. Go to https://developers.facebook.com/ and create a free account
# 2. Click "My Apps" → "Create App"
# 3. Choose "Other" → "Consumer" → give it a name (e.g. "beingvortex-bot")
# 4. Inside your app, click "Add Product" → find "Threads API" → click "Set Up"
# 5. Go to "Threads API" → "Quickstart"
# 6. Under "Permissions" make sure these are added:
#      - threads_basic
#      - threads_content_publish
# 7. Use the "Access Token" section to generate a User Token
#    (Token will expire in 1 hour — see below to get a 60-day token)
#
# To get a LONG-LIVED token (valid 60 days):
#   curl "https://graph.threads.net/access_token?grant_type=th_exchange_token&client_id=YOUR_APP_ID&client_secret=YOUR_APP_SECRET&access_token=SHORT_LIVED_TOKEN"
#
# To get your USER ID once you have the token:
#   curl "https://graph.threads.net/v1.0/me?access_token=YOUR_TOKEN"
#   → Look for the "id" field in the response
#
# To REFRESH the 60-day token before it expires:
#   curl "https://graph.threads.net/refresh_access_token?grant_type=th_refresh_token&access_token=YOUR_LONG_LIVED_TOKEN"

THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# ── Agent config ─────────────────────────────────────────────────────────────
# How many news items to post per run (each = 2 posts: ES + EN)
MAX_POSTS_PER_RUN=2

# How many hours between runs in --schedule mode (default: every 4 hours = 6x/day)
SCHEDULE_HOURS=4

# Max news items to search for per run
MAX_NEWS_ITEMS=5
