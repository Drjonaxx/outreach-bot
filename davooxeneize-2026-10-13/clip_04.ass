Dialogue: 1,0:00:00.00,0:00:48.90,Hook,,0,0,0,,¿BAD BUNNY VE SU\NPROGRAMA?
Dialogue: 0,0:00:00.12,0:00:01.06,Sub,,0,0,0,,{\fad(60,0)}Bad Bunny mira 412.
Dialogue: 0,0:00:01.74,0:00:02.48,Sub,,0,0,0,,{\fad(60,0)}¿En serio?
Dialogue: 0,0:00:02.58,0:00:03.44,Sub,,0,0,0,,{\fad(60,0)}Bad Bunny mira 412.
Dialogue: 0,0:00:03.60,0:00:04.62,Sub,,0,0,0,,{\fad(60,0)}¿De dónde lo sacaste?
Dialogue: 0,0:00:04.82,0:00:05.98,Sub,,0,0,0,,{\fad(60,0)}Información\Nconfidencial...
Dialogue: 0,0:00:05.98,0:00:06.58,Sub,,0,0,0,,{\fad(60,0)}¿Mentira?
Dialogue: 0,0:00:06.70,0:00:07.28,Sub,,0,0,0,,{\fad(60,0)}No, de verdad.
Dialogue: 0,0:00:07.34,0:00:10.08,Sub,,0,0,0,,{\fad(60,0)}¿En serio, boludo?
Dialogue: 0,0:00:11.38,0:00:13.20,Sub,,0,0,0,,{\fad(60,0)}No sé si decirlo... Bad\NBunny es muy grosso.
Dialogue: 0,0:00:13.34,0:00:14.04,Sub,,0,0,0,,{\fad(60,0)}¿En serio?
Dialogue: 0,0:00:14.56,0:00:15.38,Sub,,0,0,0,,{\fad(60,0)}Mira 412, boludo.
Dialogue: 0,0:00:15.56,0:00:16.36,Sub,,0,0,0,,{\fad(60,0)}Top 3 de reguetón.
Dialogue: 0,0:00:16.60,0:00:19.18,Sub,,0,0,0,,{\fad(60,0)}Uno, Daddy Yankee. Dos,\NDon Omar. Tres, Bad Bunny.
Dialogue: 0,0:00:19.30,0:00:20.12,Sub,,0,0,0,,{\fad(60,0)}¿Para vos?
Dialogue: 0,0:00:20.58,0:00:24.18,Sub,,0,0,0,,{\fad(60,0)}Uno, Don Omar. Dos, Daddy\NYankee. Tres, Bad Bunny.
Dialogue: 0,0:00:25.06,0:00:26.76,Sub,,0,0,0,,{\fad(60,0)}Para mí, uno: Bad Bunny.
Dialogue: 0,0:00:29.04,0:00:33.36,Sub,,0,0,0,,{\fad(60,0)}Dos... Don Omar o Daddy\NYankee.
Dialogue: 0,0:00:33.36,0:00:36.20,Sub,,0,0,0,,{\fad(60,0)}Y tres, Ozuna.
Dialogue: 0,0:00:36.58,0:00:40.62,Sub,,0,0,0,,{\fad(60,0)}Uno, Ozuna. Dos, Bad\NBunny. Tres, Tego\NCalderón.
Dialogue: 0,0:00:42.06,0:00:44.24,Sub,,0,0,0,,{\fad(60,0)}¡Tego Calderón!
Dialogue: 0,0:00:44.36,0:00:47.72,Sub,,0,0,0,,{\fad(60,0)}Uno, Daddy Yankee. Dos,\NDon Omar. Tres, Wisin y\NYandel.
Dialogue: 0,0:00:48.26,0:00:48.82,Sub,,0,0,0,,{\fad(60,0)}¡Qué linda!
